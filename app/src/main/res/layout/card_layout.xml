<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_view"
    android:layout_margin="12dp"
    card_view:cardBackgroundColor="#FFFFFF"
    card_view:cardCornerRadius="12dp"
    card_view:cardElevation="6dp"
    card_view:contentPadding="4dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/item_image"
            android:background="@drawable/reportes"
            android:layout_width="49dp"
            android:layout_height="110dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="16dp"
            android:layout_marginRight="16dp" />

        <TextView
            android:id="@+id/item_fecha"
            android:layout_width="122dp"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_toEndOf="@+id/item_image"
            android:layout_toRightOf="@+id/item_image"
            android:padding="5dp"
            android:text="Fecha / Hora:"
            android:textSize="12sp" />

        <TextView
            android:layout_width="122dp"
            android:layout_height="wrap_content"
            android:text="Orden ID:"
            android:id="@+id/item_id"
            android:layout_toEndOf="@+id/item_image"
            android:layout_toRightOf="@+id/item_image"
            android:layout_below="@+id/item_fecha"
            android:padding="5dp"
            android:textSize="12sp" />

        <TextView
            android:layout_width="122dp"
            android:layout_height="wrap_content"
            android:text="Vehiculo:"
            android:id="@+id/item_vehiculo"
            android:layout_toEndOf="@+id/item_image"
            android:layout_toRightOf="@+id/item_image"
            android:layout_below="@+id/item_id"
            android:padding="5dp"
            android:textSize="12sp" />

        <TextView
            android:layout_width="122dp"
            android:layout_height="wrap_content"
            android:text="Conductor:"
            android:id="@+id/item_conductor"
            android:layout_toEndOf="@+id/item_image"
            android:layout_toRightOf="@+id/item_image"
            android:layout_below="@+id/item_vehiculo"
            android:padding="5dp"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="01 Nov 2024 12:05"
            android:id="@+id/item_Rfecha"
            android:layout_toEndOf="@+id/item_fecha"
            android:layout_toRightOf="@+id/item_fecha"
            android:padding="5dp"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="#ORD5638"
            android:id="@+id/item_Rid"
            android:layout_toEndOf="@+id/item_id"
            android:layout_toRightOf="@+id/item_id"
            android:layout_below="@+id/item_Rfecha"
            android:padding="5dp"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AOC 123"
            android:id="@+id/item_Rvehiculo"
            android:layout_toEndOf="@+id/item_vehiculo"
            android:layout_toRightOf="@+id/item_vehiculo"
            android:layout_below="@+id/item_Rid"
            android:padding="5dp"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="#ORD5638"
            android:id="@+id/item_Rconductor"
            android:layout_toEndOf="@+id/item_conductor"
            android:layout_toRightOf="@+id/item_conductor"
            android:layout_below="@+id/item_Rvehiculo"
            android:padding="5dp"
            android:textSize="12sp" />






    </RelativeLayout>

</androidx.cardview.widget.CardView>