<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".Fragment1">

    <!-- TODO: Update blank fragment layout -->


        <TextView
            android:id="@+id/text_numero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:text="#ORD5638"
            android:textStyle="bold"
            android:background="#E3E4E5"
            android:textColor="@color/buttonColor"
            android:textSize="40sp"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="55dp"
        android:orientation="vertical">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_numero" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/card_view"
        android:layout_margin="12dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        app:contentPadding="4dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:padding="0dp">

            <ImageView
                android:id="@+id/item_image"
                android:layout_width="55dp"
                android:layout_height="174dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"
                android:layout_marginTop="0dp"
                android:layout_marginEnd="16dp"
                android:layout_marginRight="16dp"
                android:background="@drawable/reportees" />

            <TextView
                android:id="@+id/item_fecha"
                android:layout_width="122dp"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_toEndOf="@+id/item_image"
                android:layout_toRightOf="@+id/item_image"
                android:padding="5dp"
                android:text="Fecha / Hora:"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/item_id"
                android:layout_width="122dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/item_fecha"
                android:layout_toEndOf="@+id/item_image"
                android:layout_toRightOf="@+id/item_image"
                android:padding="5dp"
                android:text="Orden ID:"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/item_vehiculo"
                android:layout_width="122dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/item_id"
                android:layout_toEndOf="@+id/item_image"
                android:layout_toRightOf="@+id/item_image"
                android:padding="5dp"
                android:text="Vehiculo:"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/item_conductor"
                android:layout_width="122dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/item_vehiculo"
                android:layout_toEndOf="@+id/item_image"
                android:layout_toRightOf="@+id/item_image"
                android:padding="5dp"
                android:text="Conductor:"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/item_Rfecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@+id/item_fecha"
                android:layout_toRightOf="@+id/item_fecha"
                android:padding="5dp"
                android:text="01 Nov 2024 12:05"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/item_Rid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/item_Rfecha"
                android:layout_toEndOf="@+id/item_id"
                android:layout_toRightOf="@+id/item_id"
                android:padding="5dp"
                android:text="#ORD5638"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/item_Rvehiculo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/item_Rid"
                android:layout_toEndOf="@+id/item_vehiculo"
                android:layout_toRightOf="@+id/item_vehiculo"
                android:padding="5dp"
                android:text="AOC 123"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/item_Rconductor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/item_Rvehiculo"
                android:layout_toEndOf="@+id/item_conductor"
                android:layout_toRightOf="@+id/item_conductor"
                android:padding="5dp"
                android:text="#ORD5638"
                android:textSize="12sp" />


            <View
                android:layout_width="260dp"
                android:layout_height="1dp"
                android:layout_below="@+id/item_conductor"
                android:layout_toEndOf="@+id/item_image"
                android:layout_marginTop="8dp"
                android:background="@color/undercolor" />

            <Button
                android:id="@+id/item_completarOrden"
                android:layout_width="134dp"
                android:layout_height="48dp"
                android:layout_below="@+id/item_Rconductor"
                android:layout_marginTop="21dp"
                android:layout_toEndOf="@+id/item_conductor"
                android:background="#3E59F4"
                android:text="Completar Orden"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

        </RelativeLayout>
    </androidx.cardview.widget.CardView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/item_Oentregas"
            android:textStyle="bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="320dp"
            android:padding="5dp"
            android:layout_marginLeft="10dp"
            android:text="Otras Entregas:"
            android:textSize="14sp" />



    </LinearLayout>



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="330dp"
        android:orientation="vertical">



        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_numero" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/card_view1"
            android:layout_margin="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:contentPadding="4dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="253dp"
                android:layout_marginTop="0dp"
                android:padding="16dp">

                <TextView
                    android:id="@+id/item_informacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:background="#289ef5"
                    android:gravity="center"
                    android:padding="5dp"
                    android:text="Información:"
                    android:textColor="#0D47A1"
                    android:textSize="14sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/item_OrdenID"
                    android:layout_width="150dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/item_informacion"
                    android:padding="5dp"
                    android:text="Orden ID:"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/item_producto"
                    android:layout_width="150dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/item_OrdenID"
                    android:padding="5dp"
                    android:text="Producto:"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/item_productoID"
                    android:layout_width="150dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/item_producto"
                    android:padding="5dp"
                    android:text="Producto ID:"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/item_destino"
                    android:layout_width="150dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/item_productoID"
                    android:padding="5dp"
                    android:text="Destino:"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/item_consignatario"
                    android:layout_width="150dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/item_destino"
                    android:padding="5dp"
                    android:text="Consignatario:"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/item_Rordenid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@+id/item_OrdenID"
                    android:layout_toRightOf="@+id/item_OrdenID"
                    android:layout_below="@+id/item_informacion"
                    android:padding="5dp"
                    android:text="A67495"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/item_Rproducto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/item_Rordenid"
                    android:layout_toEndOf="@+id/item_OrdenID"
                    android:padding="5dp"
                    android:text="----"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/item_RproductoID"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/item_Rproducto"
                    android:layout_toEndOf="@+id/item_productoID"
                    android:padding="5dp"
                    android:text="---"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/item_Rdestino"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/item_productoID"
                    android:layout_toEndOf="@+id/item_destino"
                    android:padding="5dp"
                    android:text="Chorrillos - Lima"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/item_Rconsignatario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/item_destino"
                    android:layout_toEndOf="@+id/item_destino"
                    android:padding="5dp"
                    android:text="Empresa 1"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/item_Enprogreso"
                    android:layout_width="134dp"
                    android:layout_height="48dp"
                    android:layout_below="@+id/item_Rconsignatario"
                    android:layout_marginLeft="35dp"
                    android:layout_marginTop="10dp"
                    android:layout_toEndOf="@+id/item_consignatario"
                    android:background="#FF9800"
                    android:text="En Progreso"
                    android:textColor="#000000"
                    android:textSize="12sp"
                    android:textStyle="bold" />


            </RelativeLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>


</FrameLayout>